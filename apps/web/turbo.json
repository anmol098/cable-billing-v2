{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "APP_BASE_URL",
        "EMAIL_FROM",
        "RAZORPAY_KEY_ID",
        "RAZORPAY_PLAN_ID",
        "RECEIPT_BASE_URL",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_SHA"
      ],
      "passThroughEnv": [
        "BETTER_AUTH_SECRET",
        "CRON_SECRET",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "EMAIL_OUTBOX_DIR",
        "RAZORPAY_KEY_SECRET",
        "RAZORPAY_WEBHOOK_SECRET",
        "RESEND_API_KEY",
        "SENTRY_AUTH_TOKEN",
        "TURNSTILE_SECRET_KEY",
        "UPSTASH_REDIS_REST_TOKEN",
        "UPSTASH_REDIS_REST_URL",
        "VERCEL_BRANCH_URL",
        "VERCEL_URL"
      ]
    }
  }
}
