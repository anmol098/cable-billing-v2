{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_*",
        "SENTRY_DSN",
        "SENTRY_ENVIRONMENT",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_SHA"
      ],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"]
    }
  }
}
