# Cable Billing web app: environment variables.
#
# Local setup: copy this file to apps/web/.env.local (git-ignored) and fill in what you need.
#   cp apps/web/.env.example apps/web/.env.local
# Deployed environments: set these in the Vercel project (Settings → Environment Variables).
# How to get every value, and which environment needs what: docs/runbooks/environments.md.
#
# Rules
# - Every variable is validated by apps/web/src/env.ts (a test keeps this file and the schema in sync).
# - Empty (FOO=) means unset. Locally nothing is required: `next build` works with no env at all.
#   A feature that needs a variable fails with a clear EnvError when it runs.
# - Vercel preview needs: DATABASE_URL, BETTER_AUTH_SECRET (checked when a server boots).
# - Vercel production needs every variable marked [prod] (checked by `next build`, so a
#   half-configured deploy never goes live), and live Razorpay keys, real Turnstile keys,
#   https URLs and a verified email domain.
# - Never commit real values. Only this example file is tracked by git.

# ----------------------------------------------------------------------------------------------
# Database: Neon Postgres in deployments (set by the Neon ↔ Vercel integration), Docker locally.
# ----------------------------------------------------------------------------------------------
# [prod][preview] Pooled connection string used by the app at runtime (Neon host contains "-pooler").
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cable_billing
# Direct (unpooled) connection string: migrations, drizzle-kit, tests. Same as above locally.
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5432/cable_billing

# ----------------------------------------------------------------------------------------------
# Auth (Better Auth)
# ----------------------------------------------------------------------------------------------
# [prod][preview] At least 32 characters. Generate: openssl rand -base64 32
# One value per environment. Rotating it signs every web user out.
BETTER_AUTH_SECRET=

# ----------------------------------------------------------------------------------------------
# Public URLs. The domain is not decided yet (D-21): no host is hard-coded anywhere.
# Origin only: scheme + host (+ port), no path, no trailing slash needed.
# ----------------------------------------------------------------------------------------------
# [prod] Origin of the web app (auth callbacks, links in emails). On previews it defaults to the
# branch URL, locally to http://localhost:3000.
APP_BASE_URL=http://localhost:3000
# Origin for public receipt links (<origin>/r/<token>). Defaults to APP_BASE_URL.
RECEIPT_BASE_URL=

# ----------------------------------------------------------------------------------------------
# Email (Resend, E-07): verification, password reset, failure alerts.
# ----------------------------------------------------------------------------------------------
# [prod] API key, starts with "re_". Locally leave empty unless you are testing email.
RESEND_API_KEY=
# [prod] Sender: "Name <address>". Production needs a domain verified in Resend (after H-02).
# Resend's sandbox sender onboarding@resend.dev only delivers to your own Resend login address.
EMAIL_FROM="Cable Billing <onboarding@resend.dev>"
# Local / CI end-to-end tests only (never on Vercel): with no RESEND_API_KEY, outgoing emails are
# also written as JSON files into this folder (the Playwright sign-up test reads its link there).
# EMAIL_OUTBOX_DIR=

# ----------------------------------------------------------------------------------------------
# Public contact details, shown on /contact and the legal pages (T-087).
# ----------------------------------------------------------------------------------------------
# [prod] Support email address (plain address, no display name). Razorpay and the Play Store
# listing need a public contact. Locally /contact says the details are not set up yet.
SUPPORT_EMAIL=
# Optional support mobile, +91 and 10 digits (no spaces): adds Call and WhatsApp links on /contact.
SUPPORT_PHONE=
# ----------------------------------------------------------------------------------------------
# Bot protection on sign-up (Cloudflare Turnstile, E-07).
# The values below are Cloudflare's public test keys (always pass). Production must use real keys.
# ----------------------------------------------------------------------------------------------
# [prod] Public site key for the widget (inlined into the browser bundle at build time).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# [prod] Secret key for server-side verification.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ----------------------------------------------------------------------------------------------
# Rate limiting (Upstash Redis, E-07). Set both or neither. Locally empty = in-memory fallback.
# ----------------------------------------------------------------------------------------------
# [prod] REST URL, https://<name>.upstash.io
UPSTASH_REDIS_REST_URL=
# [prod] REST token (the full-access one, not the read-only one).
UPSTASH_REDIS_REST_TOKEN=

# ----------------------------------------------------------------------------------------------
# Cron (PLAN §14). Vercel sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/*.
# ----------------------------------------------------------------------------------------------
# [prod] At least 16 characters. Generate: openssl rand -hex 32
CRON_SECRET=

# ----------------------------------------------------------------------------------------------
# SaaS subscription fee (Razorpay, D-12, D-22). Test mode everywhere except production.
# ----------------------------------------------------------------------------------------------
# [prod] rzp_test_… outside production, rzp_live_… in production. Set together with the secret.
RAZORPAY_KEY_ID=
# [prod]
RAZORPAY_KEY_SECRET=
# [prod] The secret you type into Razorpay → Webhooks. At least 16 characters: openssl rand -hex 32
RAZORPAY_WEBHOOK_SECRET=
# [prod] Monthly plan ₹400 + 18% GST = ₹472 (plan_…). Test and live mode have different ids.
RAZORPAY_PLAN_ID=

# ----------------------------------------------------------------------------------------------
# Monitoring (Sentry, E-08). Sentry stays disabled while the DSNs are empty.
# ----------------------------------------------------------------------------------------------
# [prod] DSN for server and edge code.
SENTRY_DSN=
# [prod] DSN for browser code (usually the same value as SENTRY_DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Optional: overrides the environment name shown in Sentry (default: VERCEL_ENV, else NODE_ENV).
SENTRY_ENVIRONMENT=
# Build only: source-map upload. Upload runs only when SENTRY_AUTH_TOKEN is set.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ----------------------------------------------------------------------------------------------
# Set automatically by Vercel. Never set these by hand; listed so you know they are read.
# ----------------------------------------------------------------------------------------------
# VERCEL_ENV=                  production | preview (also custom environments such as staging) | development
# NEXT_PUBLIC_VERCEL_ENV=      same, exposed to the browser
# VERCEL_GIT_COMMIT_SHA=       deployed commit (/api/health, Sentry release)
# VERCEL_URL=                  host of this deployment, no protocol
# VERCEL_BRANCH_URL=           host of the latest deployment of this git branch (preview base URL)
# NODE_ENV=                    set by Next.js (development | production | test)
