{
  "name": "cable-billing",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check . && turbo run lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "generate": "turbo run generate",
    "db:seed": "pnpm --filter @cb/db db:seed",
    "i18n:build": "pnpm --filter @cb/i18n i18n:build",
    "i18n:check": "pnpm --filter @cb/i18n i18n:check",
    "tokens:build": "pnpm --filter @cb/design-tokens tokens:build",
    "icons:build": "pnpm --filter @cb/design-tokens icons:build",
    "tasks": "node scripts/tasks.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.7",
    "typescript": "catalog:"
  }
}
