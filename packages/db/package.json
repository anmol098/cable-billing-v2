{
  "name": "@cb/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, migrations and RLS policies for Neon Postgres.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./seed": "./src/seed/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx src/seed/cli.ts",
    "db:test:clean": "tsx src/testing/clean.ts"
  },
  "dependencies": {
    "@cb/domain": "workspace:*",
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cb/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "better-auth": "1.7.7",
    "drizzle-kit": "0.31.11",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "8.22.0"
  }
}
