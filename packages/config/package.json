{
  "name": "@cb/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript presets for every workspace package and app.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./tsconfig.lib.json": "./tsconfig.lib.json",
    "./tsconfig.next.json": "./tsconfig.next.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
